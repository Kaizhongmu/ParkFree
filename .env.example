POSTGRES_DB=parking_ai
POSTGRES_USER=parking_ai
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
API_PORT=8000
DATABASE_URL=postgresql+psycopg://parking_ai:change-me@localhost:5432/parking_ai
LOG_LEVEL=INFO
# Phase 6 search remains unavailable until a genuinely configured parking fallback is supplied.
# PARKING_FALLBACK_LATITUDE=<verified-latitude>
# PARKING_FALLBACK_LONGITUDE=<verified-longitude>
# PARKING_FALLBACK_ID=configured-parking-fallback
# PARKING_FALLBACK_DESCRIPTION=Proceed to the configured parking fallback.
# LOCAL_DRIVING_SPEED_M_PER_MIN=400.0
# Optional zero-cost US destination discovery. Use an identifying application/contact string;
# no API key or billing account is required. The parking search remains cached-data-only.
# NOMINATIM_USER_AGENT=ParkFree/0.1 (contact: operator@example.com)
# NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search
# NOMINATIM_TIMEOUT_SECONDS=3.0
# NOMINATIM_CACHE_TTL_SECONDS=3600
# Optional zero-cost, bounded on-demand road acquisition. On-demand parking is enabled only
# when both NOMINATIM_USER_AGENT and OVERPASS_USER_AGENT are configured.
# OVERPASS_USER_AGENT=ParkFree/0.1 (contact: operator@example.com)
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# OVERPASS_TIMEOUT_SECONDS=20.0
# OVERPASS_CACHE_TTL_SECONDS=3600
